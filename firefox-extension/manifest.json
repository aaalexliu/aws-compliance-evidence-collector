{
  "manifest_version": 2,
  "name": "Evidence Collection Suite",
  "version": "1.0",
  "description": "AI-powered compliance evidence collection with automated workflow generation",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "<all_urls>"
  ],
  "browser_action": {
    "default_title": "Evidence Collection",
    "default_popup": "ui/popup.html"
  },
  "sidebar_action": {
    "default_title": "Evidence Collection Suite",
    "default_panel": "ui/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["core/content.js"]
    }
  ],
  "background": {
    "scripts": ["core/background.js"],
    "persistent": false
  },
  "web_accessible_resources": [
    "config/workflow-config.json",
    "ui/landing.html",
    "ui/workflow-designer.html"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "evidence-collector@aws.amazon.com",
      "strict_min_version": "109.0"
    }
  }
}
